# SHELL
alias ls='ls --color=auto'
alias ll='ls --color=auto -la'
alias reload='exec zsh'
alias bat='bat --theme=ansi --style=changes'   # ansi follows the terminal's light or dark theme

# NAVIGATION
alias scratch='cd ~/scratch'
alias work='cd ~/work'

# TMUX
alias tmux='tmux -u'

# KUBERNETES
alias k='kubectl'
