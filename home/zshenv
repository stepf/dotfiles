# Read by every zsh, scripts and agents included: environment only, interactive setup goes in .zshrc.
function _has { hash "${1}" 2> /dev/null }
function _is_macos { [[ "$OSTYPE" == darwin* ]] }

# Keep PATH unique across nested shells. It needs PATH too, because `path` alone misses string assignments.
typeset -U PATH path

# GENERAL
export EDITOR='vim'
export LESS=" -R "
export LANG=en_US.UTF-8
# ~/.shims must stay first, or gh and claude bypass the account switch.
export PATH="$HOME/.shims:$HOME/.bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH"

# BREW (output of `brew shellenv`, hardcoded to save a process per shell)
if _is_macos && [ -d /opt/homebrew/bin ]; then
  export HOMEBREW_PREFIX="/opt/homebrew"
  export HOMEBREW_CELLAR="/opt/homebrew/Cellar"
  export HOMEBREW_REPOSITORY="/opt/homebrew"
  export PATH="/opt/homebrew/bin:/opt/homebrew/sbin:$PATH"
  [ -z "${MANPATH-}" ] || export MANPATH=":${MANPATH#:}"
  export INFOPATH="/opt/homebrew/share/info:${INFOPATH:-}"
fi
export HOMEBREW_NO_INSECURE_REDIRECT=1
export HOMEBREW_CASK_OPTS=--require-sha

# FZF: no background colours, and the selected line is reverse video, so it stays readable in light and dark.
export FZF_DEFAULT_OPTS="--height 50% --min-height 30 --border --ansi --color 16,bg+:-1,gutter:-1:dim,fg+:-1:reverse"

# GO (GOPATH is set with `go env -w` so cron sees it too; don't export it here)
export PATH=$HOME/go/bin:$PATH

# GOOGLE CLOUD SDK (completion is lazy-loaded in .zshrc)
[ -d "$HOME/.google-cloud-sdk/bin" ] && export PATH="$HOME/.google-cloud-sdk/bin:$PATH"

# NODE: On hosts with a low memory limit, cap the heap, so a runaway process fails
# before the OOM killer takes down the whole user slice.
_mem_cgroup="/sys/fs/cgroup/memory/user.slice/user-${UID}.slice/memory.limit_in_bytes"
if [[ -r "$_mem_cgroup" ]] && (( $(<"$_mem_cgroup") < 3221225472 )) \
   && [[ "$NODE_OPTIONS" != *max-old-space-size* ]]; then
  export NODE_OPTIONS="${NODE_OPTIONS:+$NODE_OPTIONS }--max-old-space-size=700"
fi
unset _mem_cgroup

# PIPX
export PATH="$HOME/.local/bin:$PATH"

# PYTHON
if [ -f "$HOME/.poetry/env" ]; then source "$HOME/.poetry/env"; fi

# SUBLIME TEXT
_is_macos && export PATH="/Applications/Sublime Text.app/Contents/SharedSupport/bin:$PATH"

# VSCODE
_is_macos && export PATH="$HOME/Applications/Visual Studio Code.app/Contents/Resources/app/bin:$PATH"

# HELM
_is_macos && export PATH="/opt/homebrew/opt/helm@3/bin:$PATH"

# RUST
if [ -f "$HOME/.cargo/env" ]; then
  . "$HOME/.cargo/env"
elif [ -d "$HOME/.cargo/bin" ]; then
  export PATH="$HOME/.cargo/bin:$PATH"
fi

# BUN (completion is sourced in .zshrc)
export BUN_INSTALL="$HOME/.bun"
[ -d "$BUN_INSTALL/bin" ] && export PATH="$BUN_INSTALL/bin:$PATH"
