{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cur=\"$(readlink -f \"$HOME/.local/bin/claude\" 2>/dev/null)\"; case \"$cur\" in \"$HOME/.local/share/claude/versions/\"*) [ -f \"$cur\" ] && find \"$HOME/.local/share/claude/versions\" -maxdepth 1 -type f ! -name \"${cur##*/}\" -delete 2>/dev/null;; esac",
            "async": true
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "padding": 0
  },
  "outputStyle": "Plain language",
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": [
      "Blooming",
      "Dialing-in",
      "Pre-infusing",
      "Center-pouring",
      "Circular-pouring",
      "Souping",
      "Tamping",
      "WDT-ing",
      "RDT-ing",
      "Purging the grinder",
      "Backflushing",
      "Knocking the puck",
      "Diagnosing a sour shot",
      "Reading TDS",
      "Taring",
      "Pulling 1:3 in 20s",
      "Cupping",
      "Breaking the crust",
      "Slurping",
      "Chasing acidity",
      "Inoculating",
      "Honey-processing",
      "Dosing Epsom and bicarb",
      "Balancing GH and KH",
      "Dosing Third Wave Water",
      "Checking alkalinity",
      "Descaling",
      "Bracing for a Lance hot take",
      "Rewatching Hoffmann",
      "Waiting for the TPC drop",
      "Waiting for the GWO drop",
      "Losing 0.3 g to retention"
    ]
  },
  "effortLevel": "high",
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "theme": "auto",
  "agentPushNotifEnabled": true
}
